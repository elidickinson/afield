{
  "name": "afield",
  "version": "0.1.0",
  "description": "TUI-friendly mobile web terminal",
  "bin": {
    "afield": "afield"
  },
  "files": [
    "afield",
    "pi-extensions",
    "server",
    "src",
    "tsconfig.json",
    "vendor"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-timeout=60000 'tests/unit/**/*.test.js'",
    "test:integrity": "node --test 'tests/integrity/*.test.js'",
    "test:real-pi": "node --test 'tests/real-pi/*.test.js'",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test -c playwright.smoke.config.js",
    "typecheck": "tsc --noEmit"
  },
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.18",
    "@wterm/core": "0.5.10",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "esbuild": "^0.28.2",
    "uqr": "0.1.3",
    "ws": "^8.21.3"
  }
}
